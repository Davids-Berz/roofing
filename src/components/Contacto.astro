---
// Contact.astro
const contactMethods = [
  {
    id: 1,
    icon: "phone",
    title: "Call Us Today",
    description: "Speak directly with our roofing experts",
    value: "(555) 123-4567",
    action: "tel:+15551234567",
    available: "24/7 Emergency Service"
  },
  {
    id: 2,
    icon: "email",
    title: "Email Us",
    description: "Get a detailed response within 24 hours",
    value: "info@eleganceroofing.com",
    action: "mailto:info@eleganceroofing.com",
    available: "Professional Consultation"
  },
  {
    id: 3,
    icon: "location",
    title: "Visit Our Office",
    description: "Stop by for an in-person consultation",
    value: "123 Main Street, City, State 12345",
    action: "https://maps.google.com",
    available: "Mon-Fri 8AM-6PM"
  },
  {
    id: 4,
    icon: "calendar",
    title: "Schedule Inspection",
    description: "Book your free roof inspection online",
    value: "Free Estimate Available",
    action: "#schedule",
    available: "Same Day Service"
  }
];

const serviceAreas = [
  "Downtown", "Westside", "Eastside", "Northtown", 
  "Southwood", "Riverside", "Hillcrest", "Valley View"
];
---

<section id="contacto" class="contact-section">
  <!-- Light background like WhyUs -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-50 via-white to-slate-100"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-white/80 via-slate-50/60 to-white/90"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-slate-50/60 via-transparent to-slate-100/60"></div>
    <div class="absolute inset-0 bg-[radial-gradient(1400px_700px_at_20%_20%,rgba(59,130,246,.04),transparent_70%),radial-gradient(1200px_600px_at_80%_80%,rgba(14,165,233,.03),transparent_70%)]"></div>
  </div>

  <!-- Content container -->
  <div class="relative z-10 py-16 md:py-24">
    <div class="mx-auto w-[92%] max-w-[1400px]">
      
      <!-- Header -->
      <div class="text-center mb-16">
        <div class="inline-flex items-center gap-2 rounded-full border border-blue-500/30 bg-blue-500/10 px-5 py-2 backdrop-blur-md mb-6">
          <span class="h-2 w-2 rounded-full bg-blue-500 animate-pulse"></span>
          <span class="text-blue-700 text-sm font-medium">Get In Touch</span>
        </div>
        
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-slate-900 mb-6 leading-tight">
          <span class="block">Ready to Get</span>
          <span class="block bg-gradient-to-r from-blue-600 via-blue-700 to-cyan-600 bg-clip-text text-transparent">
            Started?
          </span>
        </h2>
        
        <p class="text-lg md:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
          Contact us today for your free roofing consultation. Our experts are ready to help 
          with any questions about your roofing project.
        </p>
      </div>

      <!-- Contact Methods Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-16">
        {contactMethods.map((method, index) => (
          <a 
            href={method.action}
            class="contact-card group"
            data-index={index}
          >
            <!-- Icon -->
            <div class="icon-container">
              {method.icon === "phone" && (
                <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                </svg>
              )}
              {method.icon === "email" && (
                <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                  <polyline points="22,6 12,13 2,6"/>
                </svg>
              )}
              {method.icon === "location" && (
                <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              )}
              {method.icon === "calendar" && (
                <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                  <line x1="16" y1="2" x2="16" y2="6"/>
                  <line x1="8" y1="2" x2="8" y2="6"/>
                  <line x1="3" y1="10" x2="21" y2="10"/>
                </svg>
              )}
            </div>

            <!-- Content -->
            <div class="card-content">
              <h3 class="card-title">{method.title}</h3>
              <p class="card-description">{method.description}</p>
              <div class="card-value">{method.value}</div>
              <div class="card-availability">{method.available}</div>
            </div>

            <!-- Arrow -->
            <div class="arrow-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M7 17L17 7"/>
                <path d="M7 7h10v10"/>
              </svg>
            </div>
          </a>
        ))}
      </div>

      <!-- Main Content Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        
        <!-- Contact Form -->
        <div class="form-container">
          <div class="form-header">
            <h3 class="form-title">Send Us a Message</h3>
            <p class="form-subtitle">Fill out the form below and we'll get back to you within 24 hours.</p>
          </div>

          <form class="contact-form" id="contactForm">
            <div class="form-grid">
              <div class="form-group">
                <label for="firstName" class="form-label">First Name *</label>
                <input 
                  type="text" 
                  id="firstName" 
                  name="firstName" 
                  class="form-input"
                  required
                />
              </div>
              
              <div class="form-group">
                <label for="lastName" class="form-label">Last Name *</label>
                <input 
                  type="text" 
                  id="lastName" 
                  name="lastName" 
                  class="form-input"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label for="email" class="form-label">Email Address *</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                class="form-input"
                required
              />
            </div>

            <div class="form-group">
              <label for="phone" class="form-label">Phone Number</label>
              <input 
                type="tel" 
                id="phone" 
                name="phone" 
                class="form-input"
              />
            </div>

            <div class="form-group">
              <label for="service" class="form-label">Service Needed</label>
              <select id="service" name="service" class="form-select">
                <option value="">Select a service</option>
                <option value="residential">Residential Roofing</option>
                <option value="commercial">Commercial Roofing</option>
                <option value="repair">Roof Repair</option>
                <option value="emergency">Emergency Service</option>
                <option value="inspection">Roof Inspection</option>
                <option value="other">Other</option>
              </select>
            </div>

            <div class="form-group">
              <label for="message" class="form-label">Message *</label>
              <textarea 
                id="message" 
                name="message" 
                rows="4" 
                class="form-textarea"
                placeholder="Tell us about your roofing project..."
                required
              ></textarea>
            </div>

            <button type="submit" class="submit-btn">
              <span class="btn-text">Send Message</span>
              <svg class="btn-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <line x1="22" y1="2" x2="11" y2="13"/>
                <polygon points="22,2 15,22 11,13 2,9 22,2"/>
              </svg>
            </button>
          </form>
        </div>

        <!-- Contact Info & Map -->
        <div class="info-container">
          <!-- Business Hours -->
          <div class="info-card">
            <h3 class="info-title">Business Hours</h3>
            <div class="hours-list">
              <div class="hour-item">
                <span class="day">Monday - Friday</span>
                <span class="time">8:00 AM - 6:00 PM</span>
              </div>
              <div class="hour-item">
                <span class="day">Saturday</span>
                <span class="time">9:00 AM - 4:00 PM</span>
              </div>
              <div class="hour-item">
                <span class="day">Sunday</span>
                <span class="time">Emergency Only</span>
              </div>
              <div class="hour-item emergency">
                <span class="day">Emergency Service</span>
                <span class="time">24/7 Available</span>
              </div>
            </div>
          </div>

          <!-- Service Areas -->
          <div class="info-card">
            <h3 class="info-title">Service Areas</h3>
            <p class="info-description">We proudly serve the following areas:</p>
            <div class="areas-grid">
              {serviceAreas.map((area) => (
                <div class="area-badge">{area}</div>
              ))}
            </div>
          </div>

          <!-- Map Placeholder -->
          <div class="map-container">
            <div class="map-placeholder">
              <div class="map-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                  <circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <h4 class="map-title">Our Location</h4>
              <p class="map-address">123 Main Street<br/>City, State 12345</p>
              <a href="https://maps.google.com" class="map-link">
                Get Directions
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
                  <polyline points="15,3 21,3 21,9"/>
                  <line x1="10" y1="14" x2="21" y2="3"/>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    overflow: hidden;
  }

  /* Contact Cards */
  .contact-card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: 20px;
    padding: 2rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .contact-card:hover {
    transform: translateY(-8px);
    border-color: rgba(59, 130, 246, 0.3);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
  }

  .icon-container {
    width: 64px;
    height: 64px;
    background: linear-gradient(135deg, #eff6ff, #dbeafe);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.5rem;
    transition: all 0.3s ease;
  }

  .contact-card:hover .icon-container {
    background: linear-gradient(135deg, #dbeafe, #bfdbfe);
    transform: scale(1.1);
  }

  .contact-icon {
    width: 28px;
    height: 28px;
    color: #2563eb;
    stroke-width: 2;
  }

  .card-content {
    flex: 1;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }

  .card-description {
    color: #64748b;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  .card-value {
    color: #1e40af;
    font-weight: 600;
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }

  .card-availability {
    color: #059669;
    font-size: 0.85rem;
    font-weight: 500;
  }

  .arrow-icon {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 24px;
    height: 24px;
    color: #94a3b8;
    transition: all 0.3s ease;
    opacity: 0;
  }

  .contact-card:hover .arrow-icon {
    opacity: 1;
    color: #2563eb;
    transform: translate(4px, -4px);
  }

  .arrow-icon svg {
    width: 100%;
    height: 100%;
    stroke-width: 2;
  }

  /* Form Container */
  .form-container {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: 24px;
    padding: 2.5rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
  }

  .form-header {
    margin-bottom: 2rem;
  }

  .form-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }

  .form-subtitle {
    color: #64748b;
    line-height: 1.5;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-label {
    font-weight: 600;
    color: #374151;
    font-size: 0.9rem;
  }

  .form-input,
  .form-select,
  .form-textarea {
    padding: 0.875rem 1rem;
    border: 1px solid rgba(209, 213, 219, 0.8);
    border-radius: 12px;
    font-size: 0.95rem;
    transition: all 0.3s ease;
    background: rgba(255, 255, 255, 0.8);
  }

  .form-input:focus,
  .form-select:focus,
  .form-textarea:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
    background: rgba(255, 255, 255, 0.95);
  }

  .form-textarea {
    resize: vertical;
    min-height: 120px;
  }

  .submit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: white;
    border: none;
    border-radius: 12px;
    padding: 1rem 2rem;
    font-weight: 600;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 16px rgba(59, 130, 246, 0.3);
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(59, 130, 246, 0.4);
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
  }

  .btn-icon {
    width: 18px;
    height: 18px;
    stroke-width: 2;
    transition: transform 0.3s ease;
  }

  .submit-btn:hover .btn-icon {
    transform: translateX(4px);
  }

  /* Info Container */
  .info-container {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: 20px;
    padding: 2rem;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .info-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 1rem;
  }

  .info-description {
    color: #64748b;
    margin-bottom: 1rem;
    line-height: 1.5;
  }

  /* Hours */
  .hours-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .hour-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.75rem 0;
    border-bottom: 1px solid rgba(226, 232, 240, 0.5);
  }

  .hour-item:last-child {
    border-bottom: none;
  }

  .hour-item.emergency {
    background: rgba(34, 197, 94, 0.05);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    border: 1px solid rgba(34, 197, 94, 0.2);
  }

  .day {
    font-weight: 600;
    color: #374151;
  }

  .time {
    color: #64748b;
    font-weight: 500;
  }

  .emergency .day,
  .emergency .time {
    color: #059669;
  }

  /* Service Areas */
  .areas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: 0.75rem;
  }

  .area-badge {
    background: rgba(59, 130, 246, 0.1);
    color: #1e40af;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    text-align: center;
    font-size: 0.85rem;
    font-weight: 500;
    border: 1px solid rgba(59, 130, 246, 0.2);
  }

  /* Map */
  .map-container {
    background: rgba(255, 255, 255, 0.9);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(226, 232, 240, 0.5);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .map-placeholder {
    padding: 3rem 2rem;
    text-align: center;
    background: linear-gradient(135deg, #f8fafc, #f1f5f9);
  }

  .map-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 1rem;
    color: #3b82f6;
  }

  .map-icon svg {
    width: 100%;
    height: 100%;
    stroke-width: 2;
  }

  .map-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin-bottom: 0.5rem;
  }

  .map-address {
    color: #64748b;
    margin-bottom: 1.5rem;
    line-height: 1.5;
  }

  .map-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #3b82f6;
    text-decoration: none;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .map-link:hover {
    color: #2563eb;
    transform: translateY(-1px);
  }

  .map-link svg {
    width: 16px;
    height: 16px;
    stroke-width: 2;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .contact-card {
      padding: 1.5rem;
    }
    
    .form-container,
    .info-card {
      padding: 2rem;
    }
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
    
    .form-grid {
      grid-template-columns: 1fr;
    }
    
    .contact-card {
      padding: 1.25rem;
    }
    
    .form-container {
      padding: 1.5rem;
    }
    
    .areas-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .contact-card,
    .submit-btn,
    .map-link {
      transition: none;
    }
    
    .contact-card:hover {
      transform: none;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    const form = document.getElementById('contactForm');
    const submitBtn = document.querySelector('.submit-btn');
    const btnText = document.querySelector('.btn-text');
    
    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        
        // Add loading state
        submitBtn.disabled = true;
        btnText.textContent = 'Sending...';
        submitBtn.style.opacity = '0.7';
        
        // Simulate form submission
        setTimeout(() => {
          // Show success state
          btnText.textContent = 'Message Sent!';
          submitBtn.style.background = 'linear-gradient(135deg, #059669, #047857)';
          
          // Reset form
          form.reset();
          
          // Reset button after 3 seconds
          setTimeout(() => {
            submitBtn.disabled = false;
            btnText.textContent = 'Send Message';
            submitBtn.style.opacity = '1';
            submitBtn.style.background = '';
          }, 3000);
        }, 2000);
      });
    }

    // Add entrance animations
    const observerOptions = {
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px'
    };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.style.opacity = '1';
          entry.target.style.transform = 'translateY(0)';
        }
      });
    }, observerOptions);

    // Observe contact cards
    document.querySelectorAll('.contact-card').forEach((card, index) => {
      card.style.opacity = '0';
      card.style.transform = 'translateY(30px)';
      card.style.transition = `all 0.6s ease ${index * 0.1}s`;
      observer.observe(card);
    });
  });
</script>