---

export interface NavItem {
  key: string;
  label: string;
  href: string;
  icon: string; // raw <path .../> string
}

interface Props { items?: NavItem[] }
const defaults: NavItem[] = [
  {
    key: "home",
    label: "home",
    href: "#hero",
    icon: `<path d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    key: "BeforeAfter",
    label: "Before & After",
    href: "#beforeafter",
    icon: `<path d="M4 6h16M4 10h16M4 14h16M4 18h16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
    {
    key: "WhyUs",
    label: "Why Us",
    href: "#whyus",
    icon: `<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    key: "Gallery",
    label: "Gallery",
    href: "#gallery",
    icon: `<path d="M4 3h16a1 1 0 011 1v16a1 1 0 01-1 1H4a1 1 0 01-1-1V4a1 1 0 011-1zM4 10h4v4H4v-4zM14 7h2v2h-2V7zM14 11h2v2h-2v-2zM10 7h2v2h-2V7zM10 11h2v2h-2v-2z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
  {
    key: "contact",
    label: "Contact Us",
    href: "#contacto",
    icon: `<path d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`,
  },
];

const { items = defaults } = Astro.props as Props;
---

<!-- Top Mobile Navigation - Fixed at top -->
<div class="lg:hidden fixed top-4 left-1/2 z-[9999] -translate-x-1/2 w-[92%] max-w-md select-none"
     style="padding-top: max(env(safe-area-inset-top), 8px);">
  
  <!-- Navigation Bar with Adaptive Colors -->
  <nav id="mobile-top-nav" aria-label="Top navigation"
       class="nav-container w-full rounded-[26px] backdrop-blur-xl shadow-[0_8px_32px_rgba(0,0,0,0.1)] transition-all duration-500 ease-out relative z-[9999]">
    
    <!-- Dynamic Background that changes based on section -->
    <div class="nav-bg absolute inset-0 rounded-[26px] transition-all duration-500 ease-out"></div>
    
    <ul class="relative flex items-center justify-between px-2 py-2 z-10">
      {items.map((item) => (
        <li class="shrink-0">
          <a href={item.href}
             data-key={item.key}
             class="nb-item group relative flex items-center gap-2 h-11 min-w-[44px] px-3 rounded-full transition-all duration-300 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500/70">
            
            <span class="nb-icon grid place-items-center h-5 w-5 transition-all duration-300">
              <svg viewBox="0 0 24 24" class="h-[18px] w-[18px] drop-shadow-sm transition-all duration-300" fill="none" set:html={item.icon} />
            </span>
            
            <span class="nb-label hidden text-[13px] font-semibold drop-shadow-sm transition-all duration-300">{item.label}</span>
            
            <!-- Active pill background -->
            <span aria-hidden="true" class="nb-pill absolute inset-0 -z-10 rounded-full opacity-0 transition-all duration-300"></span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  /* Base navigation styles */
  .nav-container {
    position: relative;
  }

  /* Base navigation visibility */
  .nav-container {
    position: relative;
    z-index: 9999;
    min-height: 56px;
    display: block !important;
    visibility: visible !important;
  }

  /* Default state - White theme for regular sections */
  .nav-container .nav-bg {
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid rgba(226, 232, 240, 0.8);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
  }

  .nav-container .nb-item {
    color: rgb(100, 116, 139);
  }

  .nav-container .nb-icon {
    color: rgb(100, 116, 139);
  }

  .nav-container .nb-item:hover {
    background: rgba(59, 130, 246, 0.1);
    color: rgb(37, 99, 235);
  }

  .nav-container .nb-item:hover .nb-icon {
    color: rgb(37, 99, 235);
  }

  /* Active state - White theme */
  .nav-container .nb-item.is-active {
    color: rgb(37, 99, 235);
  }

  .nav-container .nb-item.is-active .nb-icon {
    color: rgb(37, 99, 235);
    transform: scale(1.1);
    filter: drop-shadow(0 0 4px rgba(59, 130, 246, 0.5));
  }

  .nav-container .nb-item.is-active .nb-label {
    color: rgb(37, 99, 235);
  }

  .nav-container .nb-item.is-active .nb-pill {
    opacity: 1;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15), rgba(37, 99, 235, 0.1));
    border: 1px solid rgba(59, 130, 246, 0.2);
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.2);
  }

  /* Dark theme for hero and footer sections */
  .nav-container.dark-theme .nav-bg {
    background: rgba(30, 41, 59, 0.95);
    border: 1px solid rgba(71, 85, 105, 0.5);
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4);
  }

  .nav-container.dark-theme .nb-item {
    color: rgb(148, 163, 184);
  }

  .nav-container.dark-theme .nb-icon {
    color: rgb(148, 163, 184);
  }

  .nav-container.dark-theme .nb-item:hover {
    background: rgba(71, 85, 105, 0.5);
    color: rgb(226, 232, 240);
  }

  .nav-container.dark-theme .nb-item:hover .nb-icon {
    color: rgb(226, 232, 240);
  }

  /* Dark theme active state */
  .nav-container.dark-theme .nb-item.is-active {
    color: rgb(96, 165, 250);
  }

  .nav-container.dark-theme .nb-item.is-active .nb-icon {
    color: rgb(96, 165, 250);
    transform: scale(1.1);
    filter: drop-shadow(0 0 4px rgba(59, 130, 246, 0.5));
  }

  .nav-container.dark-theme .nb-item.is-active .nb-label {
    color: rgb(96, 165, 250);
  }

  .nav-container.dark-theme .nb-item.is-active .nb-pill {
    opacity: 1;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(147, 51, 234, 0.15));
    border: 1px solid rgba(59, 130, 246, 0.3);
    box-shadow: 0 0 12px rgba(59, 130, 246, 0.3);
  }

  /* Enhanced animations */
  .nb-item {
    position: relative;
    overflow: hidden;
  }

  .nb-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.1), rgba(147, 51, 234, 0.1));
    border-radius: inherit;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .nb-item:hover::before {
    opacity: 1;
  }

  /* Glow effect for active items */
  .nb-item.is-active {
    animation: subtle-glow 3s ease-in-out infinite;
  }

  @keyframes subtle-glow {
    0%, 100% {
      box-shadow: 0 0 8px rgba(59, 130, 246, 0.2);
    }
    50% {
      box-shadow: 0 0 16px rgba(59, 130, 246, 0.4);
    }
  }

  /* Smooth label animation */
  .nb-label {
    transform: translateX(-4px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nb-item.is-active .nb-label {
    transform: translateX(0);
    opacity: 1;
  }

  /* Entry animation - Start visible */
  .nav-container {
    transform: translateY(0);
    opacity: 1;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-container.nav-hidden {
    transform: translateY(-120%);
    opacity: 0;
  }

  .nav-container.nav-visible {
    transform: translateY(0);
    opacity: 1;
  }

  /* Responsive adjustments */
  @media (max-width: 390px) {
    .nb-item {
      min-width: 40px;
      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }
  }

  /* Reduced motion support */
  @media (prefers-reduced-motion: reduce) {
    .nb-item,
    .nb-label,
    .nb-pill,
    .nav-container {
      transition: none;
      animation: none;
    }
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    .nav-container .nav-bg {
      background: rgba(255, 255, 255, 0.98);
      border: 2px solid rgb(37, 99, 235);
    }

    .nav-container.dark-theme .nav-bg {
      background: rgba(0, 0, 0, 0.98);
      border: 2px solid rgb(59, 130, 246);
    }

    .nb-item.is-active {
      background: rgb(59, 130, 246);
      color: white;
    }
  }
</style>

<script is:inline type="module">
  (() => {
    const nav = document.getElementById('mobile-top-nav');
    if (!nav) return;

    const navContainer = nav.querySelector('.nav-container');
    const links = Array.from(nav.querySelectorAll('a[data-key]'));

    // Sections that should use dark theme
    const darkSections = ['hero', 'contacto']; // Add footer section ID here

    // Function to update nav theme based on current section
    const updateNavTheme = (currentSection) => {
      if (darkSections.includes(currentSection)) {
        navContainer.classList.add('dark-theme');
      } else {
        navContainer.classList.remove('dark-theme');
      }
    };

    const applyActive = (a) => {
      links.forEach((el) => {
        el.classList.remove('is-active');
        el.querySelector('.nb-label')?.classList.add('hidden');
        el.style.animation = '';
      });
      
      a.classList.add('is-active');
      a.querySelector('.nb-label')?.classList.remove('hidden');
      
      // Update theme based on active section
      const sectionKey = a.dataset.key;
      updateNavTheme(sectionKey);
      
      // Add subtle haptic feedback on supported devices
      if ('vibrate' in navigator) {
        navigator.vibrate(50);
      }
    };

    // Enhanced click handler with visual feedback
    links.forEach((a) => {
      a.addEventListener('click', (e) => {
        const hash = a.getAttribute('href');
        if (!hash || !hash.startsWith('#')) return;
        const target = document.querySelector(hash);
        if (!target) return;
        e.preventDefault();

        // Add click animation
        a.style.transform = 'scale(0.95)';
        setTimeout(() => {
          a.style.transform = '';
        }, 150);

        const headerHeight = 80; // Adjust based on your header height
        const lenis = (window).__lenis || (window).lenis;
        if (lenis?.scrollTo) {
          lenis.scrollTo(target, { offset: -headerHeight });
        } else {
          const top = target.getBoundingClientRect().top + window.scrollY - headerHeight;
          window.scrollTo({ top, behavior: 'smooth' });
        }

        applyActive(a);
        history.replaceState(null, '', hash);
      });

      // Add touch feedback
      a.addEventListener('touchstart', () => {
        a.style.transform = 'scale(0.98)';
      }, { passive: true });

      a.addEventListener('touchend', () => {
        setTimeout(() => {
          a.style.transform = '';
        }, 100);
      }, { passive: true });
    });

    // Enhanced intersection observer for theme switching
    const pairs = links
      .filter((v, i, self) => self.findIndex((x) => x.dataset.key === v.dataset.key) === i)
      .map((a) => ({ a, el: document.querySelector(a.getAttribute('href') || '') }))
      .filter((p) => !!p.el);

    if ('IntersectionObserver' in window && pairs.length) {
      const io = new IntersectionObserver(
        (entries) => {
          let best = null;
          for (const e of entries) {
            if (e.isIntersecting) {
              if (!best || e.intersectionRatio > (best).intersectionRatio) best = e;
            }
          }
          if (best) {
            const pair = pairs.find((p) => p.el === best.target);
            if (pair && !pair.a.classList.contains('is-active')) {
              applyActive(pair.a);
            }
          }
        },
        { 
          threshold: [0.2, 0.4, 0.6, 0.8], 
          rootMargin: '-10% 0px -70% 0px' 
        }
      );
      pairs.forEach((p) => io.observe(p.el));
    }

    // Initial state with smooth entry animation
    const initial = links.find((a) => a.getAttribute('href') === location.hash) || links[0];
    
    // Initial state - Show immediately
    navContainer.classList.add('nav-visible');
    
    // Set initial theme
    const currentHash = location.hash.replace('#', '') || 'hero';
    updateNavTheme(currentHash);
    
    if (initial) {
      applyActive(initial);
    }

    // Force visibility for debugging
    navContainer.style.display = 'block';
    navContainer.style.visibility = 'visible';
    navContainer.style.pointerEvents = 'auto';

    // Auto-hide nav on scroll (optional enhancement)
    let lastScrollY = window.scrollY;
    let scrollTimeout;
    let isNavVisible = true;

    const handleScroll = () => {
      const currentScrollY = window.scrollY;
      const scrollingDown = currentScrollY > lastScrollY;
      const scrollDelta = Math.abs(currentScrollY - lastScrollY);

      // Only hide/show if scrolling significantly
      if (scrollDelta > 20) {
        if (scrollingDown && currentScrollY > 150 && isNavVisible) {
          navContainer.classList.add('nav-hidden');
          navContainer.classList.remove('nav-visible');
          isNavVisible = false;
        } else if (!scrollingDown && !isNavVisible) {
          navContainer.classList.remove('nav-hidden');
          navContainer.classList.add('nav-visible');
          isNavVisible = true;
        }
      }

      lastScrollY = currentScrollY;

      // Show nav after scrolling stops
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        if (!isNavVisible) {
          navContainer.classList.remove('nav-hidden');
          navContainer.classList.add('nav-visible');
          isNavVisible = true;
        }
      }, 1000);
    };

    // Enable auto-hide on scroll (disabled by default for debugging)
    // window.addEventListener('scroll', handleScroll, { passive: true });

    // Show nav on mouse movement near top
    document.addEventListener('mousemove', (e) => {
      if (e.clientY < 80 && !isNavVisible) {
        navContainer.classList.remove('nav-hidden');
        navContainer.classList.add('nav-visible');
        isNavVisible = true;
      }
    });

    // Debug info
    console.log('Mobile nav initialized:', {
      nav: !!nav,
      navContainer: !!navContainer,
      linksCount: links.length,
      isVisible: navContainer.classList.contains('nav-visible')
    });
  })();
</script>