---
// Footer.astro
const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { name: "Residential Roofing", href: "#residential" },
    { name: "Commercial Roofing", href: "#commercial" },
    { name: "Roof Repair", href: "#repair" },
    { name: "Emergency Services", href: "#emergency" },
    { name: "Roof Inspection", href: "#inspection" },
    { name: "Gutter Installation", href: "#gutters" }
  ],
  company: [
    { name: "About Us", href: "#about" },
    { name: "Our Team", href: "#team" },
    { name: "Testimonials", href: "#testimonials" },
    { name: "Gallery", href: "#gallery" },
    { name: "Careers", href: "#careers" },
    { name: "Blog", href: "#blog" }
  ],
  support: [
    { name: "Contact", href: "#contact" },
    { name: "FAQ", href: "#faq" },
    { name: "Warranty", href: "#warranty" },
    { name: "Financing", href: "#financing" },
    { name: "Insurance Claims", href: "#insurance" },
    { name: "Service Areas", href: "#areas" }
  ]
};

const socialLinks = [
  { name: "Facebook", href: "https://www.facebook.com/profile.php?id=61577709573494", icon: "facebook" },
  { name: "Instagram", href: "https://www.instagram.com/eleganceroofingatx/", icon: "instagram" },
];
---

<footer id="footer" class="footer-section">
  <!-- Background -->
  <div class="footer-background">
    <div class="bg-primary"></div>
    <div class="bg-pattern"></div>
    <div class="floating-elements">
      <div class="floating-shape shape-1"></div>
      <div class="floating-shape shape-2"></div>
      <div class="floating-shape shape-3"></div>
    </div>
  </div>

  <!-- Main Footer Content -->
  <div class="footer-main">
    <div class="container">
      <!-- Top Section -->
      <div class="footer-top">
        <!-- Company Info -->
        <div class="company-section">
          <div class="logo-container">
            <div class="logo-placeholder">
              <svg class="logo-icon" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
              </svg>
            </div>
            <h3 class="company-name">Elegance Roofing</h3>
          </div>
          
          <p class="company-description">
            Professional roofing services with over 20 years of experience. 
            We provide quality craftsmanship and reliable solutions for all your roofing needs.
          </p>

          <!-- Contact Info -->
          <div class="contact-info">
            <div class="contact-item">
              <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
              </svg>
              <span>(555) 123-4567</span>
            </div>
            
            <div class="contact-item">
              <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
              <span>info@eleganceroofing.com</span>
            </div>
            
            <div class="contact-item">
              <svg class="contact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
              <span>123 Main Street, City, State 12345</span>
            </div>
          </div>

          <!-- Emergency Badge -->
          <div class="emergency-badge">
            <div class="badge-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12,6 12,12 16,14"/>
              </svg>
            </div>
            <div class="badge-content">
              <span class="badge-title">24/7 Emergency Service</span>
              <span class="badge-subtitle">Available anytime you need us</span>
            </div>
          </div>
        </div>

        <!-- Links Sections -->
        <div class="links-grid">
          <!-- Services -->
          <div class="link-column">
            <h4 class="column-title">Services</h4>
            <ul class="link-list">
              {footerLinks.services.map((link) => (
                <li>
                  <a href={link.href} class="footer-link">
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Company -->
          <div class="link-column">
            <h4 class="column-title">Company</h4>
            <ul class="link-list">
              {footerLinks.company.map((link) => (
                <li>
                  <a href={link.href} class="footer-link">
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Support -->
          <div class="link-column">
            <h4 class="column-title">Support</h4>
            <ul class="link-list">
              {footerLinks.support.map((link) => (
                <li>
                  <a href={link.href} class="footer-link">
                    {link.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Newsletter -->
        <div class="newsletter-section">
          <h4 class="newsletter-title">Stay Updated</h4>
          <p class="newsletter-description">
            Get the latest roofing tips, maintenance advice, and exclusive offers.
          </p>
          
          <form class="newsletter-form">
            <div class="input-group">
              <input 
                type="email" 
                placeholder="Enter your email" 
                class="email-input"
                required
              />
              <button type="submit" class="submit-button">
                <svg class="submit-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <line x1="22" y1="2" x2="11" y2="13"/>
                  <polygon points="22,2 15,22 11,13 2,9 22,2"/>
                </svg>
              </button>
            </div>
          </form>

          <!-- Certifications -->
          <div class="certifications">
            <div class="cert-item">
              <div class="cert-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10"/>
                  <path d="M9 12l2 2 4-4"/>
                </svg>
              </div>
              <span>Licensed & Insured</span>
            </div>
            
            <div class="cert-item">
              <div class="cert-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor">
                  <circle cx="12" cy="8" r="6"/>
                  <path d="M15.477 12.89 17 22l-5-3-5 3 1.523-9.11"/>
                </svg>
              </div>
              <span>BBB A+ Rated</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Section -->
  <div class="footer-bottom">
    <div class="container">
      <div class="bottom-content">
        <!-- Copyright -->
        <div class="copyright">
          <p>&copy; {currentYear} Elegance Roofing. All rights reserved.</p>
        </div>

        <!-- Social Links -->
        <div class="social-links">
          {socialLinks.map((social) => (
            <a href={social.href} class="social-link" aria-label={social.name}>
              {social.icon === "facebook" && (
                <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              )}
              {social.icon === "instagram" && (
                <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12.017 0C8.396 0 7.999.01 6.756.048 5.517.087 4.668.222 3.935.42 3.176.624 2.534.898 1.893 1.538.949 2.482.675 3.124.47 3.883.273 4.616.138 5.465.099 6.704.061 7.947.05 8.345.05 11.966c0 3.622.01 4.02.048 5.26.039 1.24.174 2.089.371 2.822.206.759.48 1.4 1.12 2.041.641.641 1.283.915 2.042 1.12.733.197 1.582.332 2.821.371 1.24.038 1.638.048 5.26.048 3.621 0 4.019-.01 5.259-.048 1.24-.039 2.089-.174 2.822-.371.759-.206 1.401-.48 2.042-1.12.641-.641.915-1.283 1.12-2.042.197-.733.332-1.582.371-2.822.038-1.24.048-1.638.048-5.259 0-3.622-.01-4.02-.048-5.26-.039-1.24-.174-2.089-.371-2.822C22.708 4.405 22.434 3.764 21.793 3.123 21.153 2.482 20.512 2.208 19.753 2.003c-.733-.197-1.582-.332-2.821-.371C15.692.01 15.294 0 11.673 0h.344zm-.081 1.802h.283c3.547 0 3.966.01 5.366.048 1.297.059 2.005.277 2.477.461.623.242 1.068.531 1.537 1.001.47.47.759.914 1.001 1.537.184.472.402 1.18.461 2.477.038 1.4.047 1.819.047 5.366 0 3.547-.009 3.966-.047 5.366-.059 1.297-.277 2.005-.461 2.477-.242.623-.531 1.068-1.001 1.537-.47.47-.914.759-1.537 1.001-.472.184-1.18.402-2.477.461-1.4.038-1.819.047-5.366.047-3.547 0-3.966-.009-5.366-.047-1.297-.059-2.005-.277-2.477-.461-.623-.242-1.068-.531-1.537-1.001-.47-.47-.759-.914-1.001-1.537-.184-.472-.402-1.18-.461-2.477-.038-1.4-.047-1.819-.047-5.366 0-3.547.009-3.966.047-5.366.059-1.297.277-2.005.461-2.477.242-.623.531-1.068 1.001-1.537.47-.47.914-.759 1.537-1.001.472-.184 1.18-.402 2.477-.461 1.4-.038 1.819-.047 5.366-.047z"/>
                  <path d="M12.017 15.33a3.314 3.314 0 1 1 0-6.627 3.314 3.314 0 0 1 0 6.627zm0-8.468a5.154 5.154 0 1 0 0 10.308 5.154 5.154 0 0 0 0-10.308zm6.532-1.325a1.2 1.2 0 1 1-2.4 0 1.2 1.2 0 0 1 2.4 0z"/>
                </svg>
              )}
              {social.icon === "twitter" && (
                <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                </svg>
              )}
              {social.icon === "linkedin" && (
                <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {social.icon === "youtube" && (
                <svg class="social-icon" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                </svg>
              )}
            </a>
          ))}
        </div>

        <!-- Legal Links -->
        <div class="legal-links">
          <a href="#privacy" class="legal-link">Privacy Policy</a>
          <a href="#terms" class="legal-link">Terms of Service</a>
          <a href="#sitemap" class="legal-link">Sitemap</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-section {
    position: relative;
    overflow: hidden;
  }

  /* Background */
  .footer-background {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .bg-primary {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #334155 100%);
  }

  .bg-pattern {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(circle at 25% 25%, rgba(59, 130, 246, 0.05) 0%, transparent 50%),
      radial-gradient(circle at 75% 75%, rgba(147, 51, 234, 0.03) 0%, transparent 50%);
    opacity: 0.8;
  }

  .floating-elements {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .floating-shape {
    position: absolute;
    background: linear-gradient(45deg, rgba(59, 130, 246, 0.1), rgba(147, 51, 234, 0.05));
    border-radius: 50%;
    animation: floatFooter 8s ease-in-out infinite;
  }

  .shape-1 {
    width: 100px;
    height: 100px;
    top: 20%;
    left: 5%;
    animation-delay: 0s;
  }

  .shape-2 {
    width: 60px;
    height: 60px;
    top: 60%;
    right: 10%;
    animation-delay: -3s;
  }

  .shape-3 {
    width: 80px;
    height: 80px;
    bottom: 30%;
    left: 70%;
    animation-delay: -6s;
  }

  @keyframes floatFooter {
    0%, 100% { transform: translateY(0px) rotate(0deg); opacity: 0.3; }
    50% { transform: translateY(-20px) rotate(180deg); opacity: 0.6; }
  }

  /* Main Footer */
  .footer-main {
    position: relative;
    z-index: 10;
    padding: 4rem 0 2rem;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  /* Company Section */
  .company-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .logo-container {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .logo-placeholder {
    width: 48px;
    height: 48px;
    background: linear-gradient(135deg, #3b82f6, #8b5cf6);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
  }

  .logo-icon {
    width: 24px;
    height: 24px;
    color: white;
  }

  .company-name {
    font-size: 1.5rem;
    font-weight: 800;
    color: #f8fafc;
    margin: 0;
  }

  .company-description {
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
  }

  .contact-info {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .contact-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #cbd5e1;
    font-size: 0.9rem;
  }

  .contact-icon {
    width: 18px;
    height: 18px;
    color: #3b82f6;
    stroke-width: 2;
    flex-shrink: 0;
  }

  .emergency-badge {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: 12px;
    padding: 1rem;
    margin-top: 1rem;
  }

  .badge-icon {
    width: 32px;
    height: 32px;
    background: rgba(34, 197, 94, 0.2);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .badge-icon svg {
    width: 18px;
    height: 18px;
    color: #22c55e;
    stroke-width: 2;
  }

  .badge-content {
    display: flex;
    flex-direction: column;
  }

  .badge-title {
    color: #22c55e;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .badge-subtitle {
    color: #94a3b8;
    font-size: 0.8rem;
  }

  /* Links Grid */
  .links-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .link-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .column-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #f8fafc;
    margin: 0 0 0.5rem 0;
  }

  .link-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-link {
    color: #94a3b8;
    text-decoration: none;
    font-size: 0.9rem;
    transition: all 0.3s ease;
    position: relative;
    padding: 0.25rem 0;
  }

  .footer-link:hover {
    color: #3b82f6;
    transform: translateX(4px);
  }

  .footer-link::before {
    content: '';
    position: absolute;
    left: -8px;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    background: #3b82f6;
    border-radius: 50%;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .footer-link:hover::before {
    opacity: 1;
  }

  /* Newsletter Section */
  .newsletter-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .newsletter-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #f8fafc;
    margin: 0;
  }

  .newsletter-description {
    color: #94a3b8;
    font-size: 0.9rem;
    line-height: 1.5;
    margin: 0;
  }

  .newsletter-form {
    margin: 1rem 0;
  }

  .input-group {
    display: flex;
    background: rgba(51, 65, 85, 0.5);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .input-group:focus-within {
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  .email-input {
    flex: 1;
    background: transparent;
    border: none;
    padding: 0.875rem 1rem;
    color: #f8fafc;
    font-size: 0.9rem;
    outline: none;
  }

  .email-input::placeholder {
    color: #64748b;
  }

  .submit-button {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    border: none;
    padding: 0.875rem 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .submit-button:hover {
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
    transform: scale(1.05);
  }

  .submit-icon {
    width: 18px;
    height: 18px;
    color: white;
    stroke-width: 2;
  }

  /* Certifications */
  .certifications {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .cert-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: #cbd5e1;
    font-size: 0.85rem;
  }

  .cert-icon {
    width: 20px;
    height: 20px;
    color: #3b82f6;
    stroke-width: 2;
    flex-shrink: 0;
  }

  /* Footer Bottom */
  .footer-bottom {
    border-top: 1px solid rgba(71, 85, 105, 0.3);
    padding: 1.5rem 0;
    background: rgba(15, 23, 42, 0.5);
  }

  .bottom-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .copyright {
    color: #64748b;
    font-size: 0.85rem;
  }

  .copyright p {
    margin: 0;
  }

  /* Social Links */
  .social-links {
    display: flex;
    gap: 0.75rem;
  }

  .social-link {
    width: 40px;
    height: 40px;
    background: rgba(51, 65, 85, 0.5);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #94a3b8;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .social-link:hover {
    background: rgba(59, 130, 246, 0.1);
    border-color: #3b82f6;
    color: #3b82f6;
    transform: translateY(-2px);
  }

  .social-icon {
    width: 18px;
    height: 18px;
  }

  /* Legal Links */
  .legal-links {
    display: flex;
    gap: 1.5rem;
  }

