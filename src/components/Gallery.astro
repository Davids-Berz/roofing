---
// Gallery.astro
import img1 from "@assets/frames/antes.png";
import img2 from "@assets/frames/despues.png";

const items = [
  {
    id: 1,
    title: "Modern Roofing Installation",
    category: "Residential",
    description: "Complete roof replacement with premium materials and modern design.",
    src: img1,
    href: "#project-1"
  },
  {
    id: 2,
    title: "Commercial Building Restoration",
    category: "Commercial",
    description: "Large-scale commercial roofing project with energy-efficient solutions.",
    src: img2,
    href: "#project-2"
  },
  {
    id: 3,
    title: "Historic Home Renovation",
    category: "Heritage",
    description: "Careful restoration maintaining historical integrity while improving performance.",
    src: img1,
    href: "#project-3"
  },
  {
    id: 4,
    title: "Industrial Complex Upgrade",
    category: "Industrial",
    description: "High-performance industrial roofing with advanced weatherproofing.",
    src: img2,
    href: "#project-4"
  },
  {
    id: 5,
    title: "Luxury Villa Project",
    category: "Premium",
    description: "Premium roofing solution for high-end residential property.",
    src: img1,
    href: "#project-5"
  },
  {
    id: 6,
    title: "Sustainable Green Roofing",
    category: "Eco-Friendly",
    description: "Environmentally conscious roofing with sustainable materials.",
    src: img2,
    href: "#project-6"
  },
];

// Categorías para filtros
const categories = ["All", ...Array.from(new Set(items.map(item => item.category)))];
---

<section id="gallery" class="relative py-16 md:py-24 overflow-hidden">
  <!-- Background con el estilo de la página -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-slate-50 via-blue-50 to-slate-100"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-white/60 via-blue-50/40 to-slate-50/60"></div>
    <div class="absolute inset-0 bg-[radial-gradient(1400px_700px_at_30%_20%,rgba(59,130,246,.08),transparent_70%)]"></div>
  </div>

  <div class="relative z-10 mx-auto w-[92%] max-w-[1400px]">
    
    <!-- Header Section -->
    <header class="text-center mb-12 md:mb-16">
      <div class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-5 py-2 backdrop-blur-md mb-6">
        <span class="h-2 w-2 rounded-full bg-blue-500 animate-pulse"></span>
        <span class="text-blue-700 text-sm font-medium">Our Portfolio</span>
      </div>

      <h2 class="split-text font-black tracking-tight text-[clamp(32px,5vw,48px)] text-slate-900 mb-6 leading-tight">
        Project Gallery
      </h2>
      <p class="split-text text-lg md:text-xl text-slate-600 max-w-3xl mx-auto leading-relaxed">
        Explore our completed projects showcasing exceptional craftsmanship, innovative solutions, 
        and transformative results across various property types.
      </p>
    </header>

    <!-- Filter Tabs -->
    <div class="flex flex-wrap justify-center gap-2 mb-8 md:mb-12">
      {categories.map((category, index) => (
        <button 
          class={`filter-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-300 ${
            index === 0 
              ? 'bg-blue-600 text-white shadow-lg shadow-blue-600/25' 
              : 'bg-white/80 text-slate-600 hover:bg-blue-50 hover:text-blue-600 border border-slate-200'
          }`}
          data-filter={category.toLowerCase()}
        >
          {category}
        </button>
      ))}
    </div>

    <!-- Gallery Grid con Masonry mejorado -->
    <div class="gallery-container">
      <div class="masonry-grid columns-1 gap-6 sm:columns-2 lg:columns-3 xl:columns-4 [column-fill:_balance]">
        {items.map((item, index) => (
          <article 
            class={`gallery-item group mb-6 block break-inside-avoid overflow-hidden rounded-3xl bg-white shadow-[0_10px_40px_rgba(15,23,42,.08)] ring-1 ring-slate-200/60 transition-all duration-500 hover:shadow-[0_20px_60px_rgba(15,23,42,.12)] hover:ring-blue-200 hover:-translate-y-2`}
            data-category={item.category.toLowerCase()}
            style={`animation-delay: ${index * 0.1}s`}
          >
            <a href={item.href} class="block">
              <figure class="relative">
                <!-- Image container with aspect ratio preservation -->
                <div class="relative overflow-hidden bg-slate-100">
                  <img 
                    src={item.src.src} 
                    alt={item.title} 
                    class="h-auto w-full object-cover transition-transform duration-700 group-hover:scale-110" 
                    loading="lazy" 
                  />
                  
                  <!-- Category badge -->
                  <div class="absolute top-4 left-4 z-10">
                    <span class="inline-flex items-center gap-1 rounded-full bg-white/95 backdrop-blur-sm px-3 py-1 text-xs font-semibold text-slate-700 shadow-lg">
                      <span class="h-2 w-2 rounded-full bg-blue-500"></span>
                      {item.category}
                    </span>
                  </div>

                  <!-- Overlay gradients -->
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                  <div class="absolute inset-0 bg-gradient-to-b from-slate-900/20 via-transparent to-transparent"></div>
                </div>

                <!-- Content overlay -->
                <figcaption class="absolute inset-0 flex items-end p-6">
                  <div class="w-full transform translate-y-2 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500">
                    <div class="bg-white/95 backdrop-blur-md rounded-2xl p-4 shadow-xl border border-white/20">
                      <div class="flex items-start justify-between gap-3">
                        <div class="flex-1 min-w-0">
                          <h3 class="font-bold text-slate-900 text-lg mb-1 truncate">
                            {item.title}
                          </h3>
                          <p class="text-sm text-slate-600 line-clamp-2 leading-relaxed">
                            {item.description}
                          </p>
                        </div>
                        
                        <!-- Arrow button -->
                        <div class="flex-shrink-0">
                          <div class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-blue-600 text-white shadow-lg transition-all duration-300 group-hover:bg-blue-700 group-hover:scale-110">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                              <path d="M7 17l9.2-9.2M17 17V7H7" />
                            </svg>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                </figcaption>
              </figure>
            </a>
          </article>
        ))}
      </div>
    </div>

    <!-- Load More Button -->
    <div class="text-center mt-12">
      <button class="inline-flex items-center gap-3 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold px-8 py-4 rounded-2xl shadow-lg shadow-blue-600/25 transition-all duration-300 hover:shadow-xl hover:shadow-blue-600/30 hover:-translate-y-1">
        <span>View All Projects</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14" />
          <path d="M12 5l7 7-7 7" />
        </svg>
      </button>
    </div>

    <!-- Stats Section -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 mt-16 pt-12 border-t border-slate-200">
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-black text-blue-600 mb-2">200+</div>
        <div class="text-sm text-slate-600 font-medium">Completed Projects</div>
      </div>
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-black text-blue-600 mb-2">15+</div>
        <div class="text-sm text-slate-600 font-medium">Years Experience</div>
      </div>
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-black text-blue-600 mb-2">98%</div>
        <div class="text-sm text-slate-600 font-medium">Client Satisfaction</div>
      </div>
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-black text-blue-600 mb-2">24/7</div>
        <div class="text-sm text-slate-600 font-medium">Support Available</div>
      </div>
    </div>
  </div>
</section>

<style>
  .gallery-item {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 0.8s ease-out forwards;
  }

  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .split-text {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 0.8s ease-out forwards;
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .filter-btn.active {
    background: rgb(37, 99, 235);
    color: white;
    box-shadow: 0 10px 25px rgba(37, 99, 235, 0.25);
  }

  .gallery-item.hidden {
    display: none;
  }

  .gallery-item.filtering-out {
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.3s ease-out;
  }

  .gallery-item.filtering-in {
    opacity: 1;
    transform: scale(1);
    transition: all 0.3s ease-out;
  }

  /* Hover effects mejorados */
  .gallery-item:hover {
    z-index: 10;
  }

  .gallery-item::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.05), rgba(147, 51, 234, 0.05));
    border-radius: 1.5rem;
    opacity: 0;
    transition: opacity 0.3s ease;
    z-index: -1;
  }

  .gallery-item:hover::before {
    opacity: 1;
  }

  /* Responsive improvements */
  @media (max-width: 768px) {
    .masonry-grid {
      columns: 1;
      gap: 1.5rem;
    }
    
    .gallery-item {
      margin-bottom: 1.5rem;
    }

    .filter-btn {
      font-size: 0.875rem;
      padding: 0.5rem 1rem;
    }
  }

  @media (max-width: 480px) {
    .gallery-item figcaption {
      padding: 1rem;
    }
    
    .gallery-item .bg-white\/95 {
      padding: 0.75rem;
    }
  }

  /* Loading state */
  .gallery-container.loading .gallery-item {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Dark mode support (mantener tema claro) */
  @media (prefers-color-scheme: dark) {
    /* Forzar tema claro independientemente de la preferencia del sistema */
  }

  /* High contrast mode */
  @media (prefers-contrast: high) {
    .gallery-item {
      border: 2px solid #374151;
    }
    
    .filter-btn {
      border: 2px solid #374151;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .gallery-item,
    .split-text,
    .gallery-item img,
    .gallery-item figcaption > div {
      animation: none;
      transition: none;
    }
    
    .gallery-item:hover {
      transform: none;
    }
  }
</style>

<script is:inline>
  class GalleryFilter {
    constructor() {
      this.filterButtons = document.querySelectorAll('.filter-btn');
      this.galleryItems = document.querySelectorAll('.gallery-item');
      this.container = document.querySelector('.gallery-container');
      
      this.init();
    }

    init() {
      this.bindEvents();
      this.initIntersectionObserver();
    }

    bindEvents() {
      this.filterButtons.forEach(button => {
        button.addEventListener('click', (e) => {
          const filter = e.target.getAttribute('data-filter');
          this.filterGallery(filter);
          this.updateActiveButton(e.target);
        });
      });
    }

    updateActiveButton(activeButton) {
      this.filterButtons.forEach(btn => {
        btn.classList.remove('active', 'bg-blue-600', 'text-white', 'shadow-lg', 'shadow-blue-600/25');
        btn.classList.add('bg-white/80', 'text-slate-600', 'border', 'border-slate-200');
      });
      
      activeButton.classList.add('active', 'bg-blue-600', 'text-white', 'shadow-lg', 'shadow-blue-600/25');
      activeButton.classList.remove('bg-white/80', 'text-slate-600', 'border', 'border-slate-200');
    }

    filterGallery(filter) {
      // Add loading state
      this.container.classList.add('loading');
      
      this.galleryItems.forEach((item, index) => {
        const category = item.getAttribute('data-category');
        const shouldShow = filter === 'all' || category === filter;
        
        if (shouldShow) {
          // Show item with staggered animation
          setTimeout(() => {
            item.classList.remove('hidden', 'filtering-out');
            item.classList.add('filtering-in');
            item.style.animationDelay = `${index * 0.05}s`;
          }, index * 30);
        } else {
          // Hide item
          item.classList.add('filtering-out');
          item.classList.remove('filtering-in');
          
          setTimeout(() => {
            item.classList.add('hidden');
          }, 300);
        }
      });

      // Remove loading state after animation
      setTimeout(() => {
        this.container.classList.remove('loading');
      }, 500);
    }

    initIntersectionObserver() {
      const observerOptions = {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      };

      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.style.animationPlayState = 'running';
          }
        });
      }, observerOptions);

      // Observe all gallery items and text elements
      document.querySelectorAll('.gallery-item, .split-text').forEach(el => {
        observer.observe(el);
      });
    }
  }

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    new GalleryFilter();
  });

  // Add smooth scroll for anchor links
  document.querySelectorAll('a[href^="#"]').forEach(anchor => {
    anchor.addEventListener('click', function (e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({
          behavior: 'smooth',
          block: 'start'
        });
      }
    });
  });

  // Lazy loading improvement
  if ('IntersectionObserver' in window) {
    const imageObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const img = entry.target;
          img.src = img.dataset.src || img.src;
          img.classList.remove('lazy');
          observer.unobserve(img);
        }
      });
    });

    document.querySelectorAll('img[loading="lazy"]').forEach(img => {
      imageObserver.observe(img);
    });
  }
</script>