---
/* HeroParallaxWave.astro */
import hero from "@assets/herob.png";
import logo from "@assets/logo.png";
---

<section id="hero" class="relative min-h-screen overflow-hidden isolate">
  <!-- BG: imagen + overlays -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <!-- Background con gradiente base -->
    <div class="absolute inset-0 bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900"></div>
    <img
      src={hero.src}
      alt="Professional roofing services"
      class="pointer-events-none select-none w-full h-[100%] object-cover object-center will-change-transform"
      data-parallax
      data-speed="0.5"
    />

    <!-- Gradiente mejorado para mejor contraste -->
    <div class="absolute inset-0 bg-gradient-to-b from-slate-900/30 via-slate-900/60 to-slate-900/90"></div>
    <!-- Gradiente lateral para depth -->
    <div class="absolute inset-0 bg-gradient-to-r from-slate-900/20 via-transparent to-slate-900/40"></div>
    <!-- Efectos de luz sutiles -->
    <div
      class="absolute inset-0 bg-[radial-gradient(1400px_700px_at_20%_20%,rgba(59,130,246,.12),transparent_70%),radial-gradient(1200px_600px_at_80%_80%,rgba(14,165,233,.10),transparent_70%)]"
    >
    </div>
  </div>

  <!-- Contenido principal -->
  <div class="relative z-10 flex min-h-screen items-center split-title">
    <div class="mx-auto w-[92%] max-w-[1400px] py-16">
      <div class="grid items-center gap-12 lg:grid-cols-[1.8fr_1fr] lg:gap-16">
        <!-- Columna izquierda -->
        <div class="flex flex-col gap-8 pt-16 md:pt-20  ">
          <!-- Badge -->
          <div
            class=" inline-flex w-fit items-center gap-2 rounded-full border border-blue-400/25 bg-blue-500/10 px-5 py-2 backdrop-blur-md"
            data-parallax
            data-speed="0.15"
          >
            <span class="h-2 w-2 rounded-full bg-blue-400 animate-pulse"></span>
            <span class="text-blue-200 text-sm font-sans">Licensed & Insured</span>
          </div>

          <!-- Título principal mejorado -->
          <div data-parallax data-speed="0.12">
            <h1 class="hero-title split-text">
              <span class="hero-title-line font-heading">Professional</span>
              <span class="hero-title-line hero-title-accent font-heading"> 
                Roofing Services
             </span>
            </h1>
          </div>

          <!-- Subtítulo mejorado -->
          <div data-parallax data-speed="0.10">
            <p class="hero-subtitle split-text text-light">
              Protecting your home with <strong>quality craftsmanship</strong> and reliable roofing solutions.
              <span class="text-blue-200">20+ years of trusted service.</span>
            </p>
          </div>

          <!-- CTAs mejorados -->
          <div class="flex flex-wrap items-center gap-4" data-parallax data-speed="0.08">
            <a href="#contact" class="hero-btn hero-btn--primary group" aria-label="Get free roofing inspection">
              <span>Get Free Inspection</span>
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" class="transition-transform group-hover:translate-x-1">
                <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ></path>
              </svg>
            </a>

            <a href="tel:+15551234567" class="hero-btn hero-btn--secondary" aria-label="Call for emergency roofing service">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                <path
                  d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
                ></path>
              </svg>
              <span>(555) 123-4567</span>
            </a>
          </div>

          <!-- Stats mejoradas -->
          <div class="flex flex-wrap gap-8 pt-4" data-parallax data-speed="0.06">
            <div class="hero-stat">
              <div class="hero-stat-number">500+</div>
              <div class="hero-stat-label">Projects Completed</div>
            </div>
            <div class="hero-stat">
              <div class="hero-stat-number">Lifetime</div>
              <div class="hero-stat-label">Warranty</div>
            </div>
            <div class="hero-stat">
              <div class="hero-stat-number">24/7</div>
              <div class="hero-stat-label">Emergency Service</div>
            </div>
          </div>
        </div>

<!-- Columna derecha -->
<div class="hidden lg:block" data-parallax data-speed="0.04">
  <div class="hero-feature-card relative overflow-hidden">
    <!-- Logo: esquina superior derecha -->
    <h3 class="text-2xl font-heading text-white mb-4 pr-14">Why Choose Us?</h3>

    <div class="space-y-4">
      <div class="flex items-center gap-3">
        <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </div>
        <span class="text-slate-200 font-thin text-xl">Residential & Commercial</span>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </div>
        <span class="text-slate-200  font-thin text-xl">Emergency Repairs Available</span>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-500/20 flex items-center justify-center">
          <svg class="w-4 h-4 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
          </svg>
        </div>
        <span class="text-slate-200  font-thin text-xl">Free Detailed Estimates</span>
      </div>
    </div>
  </div>
</div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Hero title styles */
  .hero-title {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    line-height: 1.20;
    letter-spacing: -0.02em;
    color: white;
    text-shadow:
      0 4px 8px rgba(0, 0, 0, 0.3),
      0 8px 16px rgba(0, 0, 0, 0.2);
    margin-bottom: 0;
  }

  .hero-title-line {
    display: block;
  }

  .hero-title-accent {
    background: linear-gradient(135deg, #60a5fa 0%, #8b5cf6 50%, #06b6d4 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    position: relative;
  }

  .hero-title-accent::after {
    content: "";
    position: absolute;
    inset: 0;
    background: inherit;
    filter: blur(20px);
    opacity: 0.3;
    z-index: -1;
  }

  /* Hero subtitle styles */
  .hero-subtitle {
    font-size: clamp(1.1rem, 2.5vw, 1.4rem);
    line-height: 1.6;
    color: rgb(226 232 240 / 0.95);
    max-width: 46ch;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }

  /* Hero buttons */
  .hero-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    border-radius: 9999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .hero-btn--primary {
    background: linear-gradient(135deg, #3b82f6, #2563eb);
    color: white;
    box-shadow:
      0 4px 14px rgba(59, 130, 246, 0.4),
      0 8px 32px rgba(59, 130, 246, 0.2);
    border: 1px solid rgba(59, 130, 246, 0.3);
  }

  .hero-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow:
      0 6px 20px rgba(59, 130, 246, 0.5),
      0 12px 40px rgba(59, 130, 246, 0.3);
    background: linear-gradient(135deg, #2563eb, #1d4ed8);
  }

  .hero-btn--secondary {
    background: rgba(255, 255, 255, 0.1);
    color: white;
    border: 1px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
  }

  .hero-btn--secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.5);
    transform: translateY(-2px);
  }

  /* Stats */
  .hero-stat {
    text-align: left;
  }

  .hero-stat-number {
    color: white;
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1;
    text-shadow: 0 2px 4px rgba(0, 0, 0, 0.2);
  }

  .hero-stat-label {
    color: rgb(226 232 240 / 0.8);
    font-size: 0.875rem;
    font-weight: 500;
    margin-top: 0.25rem;
  }

  /* Feature card */
  .hero-feature-card {
    background: rgba(30, 41, 59, 0.308);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 24px;
    padding: 2rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  /* Parallax optimizations */
  [data-parallax] {
    will-change: transform;
  }

  /* Responsive adjustments */
  @media (max-width: 768px) {
    .hero-title {
      font-size: clamp(2rem, 6vw, 3rem);
    }

    .hero-subtitle {
      font-size: 1.125rem;
    }

    .hero-btn {
      padding: 0.75rem 1.5rem;
      font-size: 0.9rem;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    [data-parallax] {
      transform: none !important;
      transition: none !important;
    }

    .animate-bounce,
    .animate-pulse {
      animation: none;
    }
  }
</style>

<script is:inline>
  // Parallax mejorado con mejor performance
  (() => {
    const parallaxElements = document.querySelectorAll("[data-parallax]");
    if (!parallaxElements.length) return;

    let ticking = false;
    let lastScrollY = 0;

    const updateParallax = () => {
      const scrollY = window.pageYOffset;
      const viewportHeight = window.innerHeight;

      parallaxElements.forEach((el) => {
        const rect = el.getBoundingClientRect();
        const elementTop = rect.top + scrollY;
        const elementHeight = rect.height;

        // Solo procesar elementos visibles
        if (rect.bottom >= 0 && rect.top <= viewportHeight) {
          const speed = parseFloat(el.dataset.speed) || 0.1;

          // Calcular el offset basado en la posición del elemento
          const yPos = (scrollY - elementTop) * speed;

          // Aplicar transformación con límites para evitar distorsión
          const clampedYPos = Math.max(-100, Math.min(100, yPos));
          el.style.transform = `translate3d(0, ${clampedYPos}px, 0)`;
        }
      });

      lastScrollY = scrollY;
      ticking = false;
    };

    const onScroll = () => {
      if (!ticking) {
        requestAnimationFrame(updateParallax);
        ticking = true;
      }
    };

    // Inicializar
    updateParallax();

    // Escuchar scroll con throttling
    window.addEventListener("scroll", onScroll, {passive: true});

    // Limpiar en resize
    window.addEventListener("resize", () => {
      requestAnimationFrame(updateParallax);
    });
  })();
</script>
